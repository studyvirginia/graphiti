# Reads IN_FILE and writes OUT_FILE as a generated C++ header declaring
#   inline char const* VAR_NAME = R"MSL(<contents of IN_FILE>)MSL";
# so the .metal file on disk is the ONE source of truth for the shader text: the C++ string used
# for the newLibraryWithSource fallback is generated from the exact same bytes the offline
# `xcrun metal` compile step (see native/CMakeLists.txt) reads to build the .metallib.
#
# Run as: cmake -DIN_FILE=... -DOUT_FILE=... -DVAR_NAME=... -P EmbedTextFile.cmake

if(NOT DEFINED IN_FILE OR NOT DEFINED OUT_FILE OR NOT DEFINED VAR_NAME)
    message(FATAL_ERROR "EmbedTextFile.cmake requires IN_FILE, OUT_FILE, VAR_NAME")
endif()

file(READ "${IN_FILE}" SHADER_SOURCE)

# R"MSL(...)MSL" is used everywhere else in this codebase for MSL string literals; the shader
# itself must not contain the literal sequence ")MSL" for this delimiter to stay valid, which
# holds for the current kernel (checked: it contains no such text).
if(SHADER_SOURCE MATCHES "\\)MSL")
    message(FATAL_ERROR "${IN_FILE} contains ')MSL' — pick a different raw-string delimiter in EmbedTextFile.cmake and in the generated header consumer")
endif()

# No namespace wrapper: this header is #included directly inside the
# `namespace Sketch { namespace detail_gpu_pointseg { ... } }` block in batched_pointseg_gpu.hpp,
# so the declaration below lands in that namespace from its include context, same as the inline
# string literal it replaces did.
set(HEADER_CONTENT "// GENERATED by EmbedTextFile.cmake from ${IN_FILE}. Do not edit by hand.\n")
string(APPEND HEADER_CONTENT "#pragma once\n\n")
string(APPEND HEADER_CONTENT "inline char const* ${VAR_NAME} = R\"MSL(\n")
string(APPEND HEADER_CONTENT "${SHADER_SOURCE}")
string(APPEND HEADER_CONTENT ")MSL\";\n")

file(WRITE "${OUT_FILE}" "${HEADER_CONTENT}")
